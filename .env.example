# ICS Community — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# (le script install.sh génère automatiquement un .env avec des mots de passe aléatoires)

# MySQL
MYSQL_HOST=localhost
MYSQL_DATABASE=ics_community
MYSQL_USER=ics_user
MYSQL_PASSWORD=ics_pass_change_me

# Application
APP_NAME="ICS Community"
APP_URL=http://localhost
APP_ENV=lab
APP_DEBUG=true
APP_SECRET=change_this_to_random_64_chars

# Mailpit (SMTP local)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@ics-community.lab

# Uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=/var/www/ics-storage/uploads
