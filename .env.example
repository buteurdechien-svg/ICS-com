# ICS Community — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs

# MySQL
MYSQL_ROOT_PASSWORD=ics_root_secret_change_me
MYSQL_DATABASE=ics_community
MYSQL_USER=ics_user
MYSQL_PASSWORD=ics_pass_change_me

# Application
APP_NAME="ICS Community"
APP_URL=http://localhost:8080
APP_ENV=lab
APP_DEBUG=true
APP_SECRET=change_this_to_random_64_chars

# Mailpit (SMTP local)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@ics-community.lab

# Uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=/var/www/storage/uploads
